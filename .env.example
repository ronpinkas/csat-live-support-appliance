# Copy to .env and fill in. Keep .env out of version control (see .gitignore).

# ── Hostnames ────────────────────────────────────────────────────────────────
# Point DNS A records for both at this host before `docker compose up`.
CSAT_HOST=csat.instantaiguru.com
LS_HOST=live-support.instantaiguru.com

# ── CSAT ─────────────────────────────────────────────────────────────────────
# The deployment MASTER secret: signs survey links AND tenant-provisioning
# tokens, so the platform uses it to mint both. Generate once and keep it
# secret (it is never shown to tenant admins).  openssl rand -base64 48
CSAT_CRYPTO_SECRET=
# Leave blank — onboard tenants via POST /provision (returns an admin invite
# link). Any unprovisioned tenant then gets a random, logged temp password.
CSAT_ADMIN_INITIAL_PW=

# ── Live Support ─────────────────────────────────────────────────────────────
LS_SITE_NAME=Live Support
LS_ADMIN_USERNAME=admin
LS_ADMIN_INITIAL_PASSWORD=
# Shared secret for platform sign-in hand-off links (auto-generated if blank,
# then printed to the live-support logs once).
LS_CONNECT_SECRET=
# Cloudflare TURN (optional; falls back to public STUN without these).
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_API_TOKEN=

# ── Image tags (pin a release, or leave at latest) ───────────────────────────
CSAT_TAG=latest
LS_TAG=latest
